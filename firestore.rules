
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to products, reviews, and banners for the website
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Explicitly allow authenticated users to read and write sales data
    match /sales/{saleId} {
       allow read, write: if request.auth != null;
    }

    // Secure all other collections by default, allowing access only to authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
