rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Sales collection rules
    match /sales/{saleId} {
      // Allow anyone to create a new sale (place an order)
      allow create: if true;
      
      // Allow only authenticated users (admins) to read, update, or delete sales
      allow read, update, delete: if request.auth != null;
    }

    // Products, Banners, Reviews, and other collections
    match /{collection}/{docId} {
      // Allow public read for all other collections
      allow read: if true;

      // Allow only authenticated users (admins) to write (create, update, delete)
      allow write: if request.auth != null;
    }
  }
}
