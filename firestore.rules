rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default rule: All documents are readable by anyone, but only writable by authenticated users.
    // This allows your public website to display products, banners, and reviews without issue.
    // All administrative actions in your dashboard (creating, updating, deleting) are protected
    // and require you to be logged in.
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
