
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to products for the website
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can write
    }

    // Allow public read access to reviews for the website
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated users can write
    }

    // Sales data should be more protected
    match /sales/{saleId} {
      // Allow creating sales from the website
      allow create: if true;
      // Only authenticated users can read or update sales
      allow read, update, delete: if request.auth != null;
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
