
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is an authenticated admin
    function isAdmin() {
      return request.auth != null;
    }

    // Products can be read by anyone, but only written by admins.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Sales can only be read and written by admins.
    match /sales/{saleId} {
      allow read, write: if isAdmin();
    }
    
    // Reviews can be read by anyone, written by admins.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners can be read by anyone, written by admins.
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Default-deny all other collections unless explicitly allowed.
    // This is a good security practice.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
