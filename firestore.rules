rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access for products, reviews, and banners for the website
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }

    // Allow only authenticated users to manage sales data
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }
    
    // Allow public to create sales (place orders)
    match /sales/{saleId} {
        allow create: if true;
    }

    // Fallback for any other collections - deny all access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
